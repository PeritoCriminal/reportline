# Copiar para .env e preencher (o ficheiro .env não vai para o Git).

# PostgreSQL
DB_NAME=reportline
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Autenticação: local | google
AUTH_PROVIDER=local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI (análise documental e IA no laudo pericial)
OPENAI_API_KEY=
FORENSIC_AI_MODEL=gpt-4o-mini
FORENSIC_AI_SANITIZATION_ENABLED=true
FORENSIC_AI_BLOCK_ON_RESIDUAL_PII=true
PRESIDIO_SPACY_MODEL=pt_core_news_lg
# Termos extras preservados na sanitização (separados por vírgula)
# FORENSIC_AI_SANITIZATION_ALLOWLIST=termo customizado,outro termo
# Após instalar deps: python -m spacy download pt_core_news_lg

# Google Safe Browsing (moderação de links). Opcional.
# https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_API_KEY=

# Google Cloud Speech-to-Text v2 (ditado por voz). Project id vazio = desabilitado.
GOOGLE_CLOUD_PROJECT_ID=
# Caminho absoluto ao JSON da service account (ou copie para var/secrets/reportline-stt-key.json)
GOOGLE_APPLICATION_CREDENTIALS_PATH=
GOOGLE_SPEECH_STT_V2_LOCATION=global
GOOGLE_SPEECH_STT_V2_RECOGNIZER=_
GOOGLE_SPEECH_STT_V2_LANGUAGE_CODE=pt-BR
GOOGLE_SPEECH_STT_V2_MODEL=long
GOOGLE_SPEECH_STT_V2_MAX_AUDIO_BYTES=10485760

# Desenvolvimento local (opcional)
SUPERUSER_USERNAME=
SUPERUSER_PASSWORD=
